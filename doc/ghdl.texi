The loop index is available as @ref{1d49,,LoopIndex}, the iteration range as @ref{1d4a,,Range} and the
loop body as @ref{1d4b,,Statements}.

@cartouche
@quotation Example 
@example
  lbl : for k in 0 to 3 loop
--^^^                          <- optional Label
--          ^                  <- LoopIndex
--               ^^^^^^        <- Range
    null;
--  ^^^^^                      <- Statements
  end loop;
@end example
@end quotation
@end cartouche


