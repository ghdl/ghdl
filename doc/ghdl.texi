signal s : rec_t(data(7 downto 0), inner(field(3 downto 0)));
--         ^^^^^                                                <- Name
--               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^     <- Constraints
@end example
@end quotation
@end cartouche

