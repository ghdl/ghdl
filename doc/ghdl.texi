@item 
@code{genericItem} (GenericInterfaceItemMixin@footnote{https://vhdl.github.io/pyVHDLModel/pyVHDLModel/pyVHDLModel.Interface.html#pyVHDLModel.Interface.GenericInterfaceItemMixin})

